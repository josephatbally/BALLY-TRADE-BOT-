# ============================================================
# BALLY TRADES BOT - ENVIRONMENT TEMPLATE
# ============================================================
# NEVER put real credentials in this file.
# Copy to .env and fill in your local values.

MT5_PATH=
MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=

# Application
BALLY_ENV=development

# Live execution safety
LIVE_TRADING=false
EXECUTION_ENABLED=false
ALLOW_ORDER_SEND=false
EXECUTION_CONFIRMATION=false
DRY_RUN=true

