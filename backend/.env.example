# BALLY FLOW authentication provider
# Keep real values out of Git and out of the mobile APK.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=

# Authentication verification mode: provider (production) or local (development only).
AUTH_VERIFICATION_MODE=provider

# Optional JWT override. Use a long random value in production.
JWT_SECRET=
